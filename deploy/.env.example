# Use a hostname you control and point its DNS A/AAAA record at your VM.
ATLAS_HOST=atlas.example.com
ATLAS_PUBLIC_URL=https://atlas.example.com
ATLAS_ORGANIZATION=conduktor
ATLAS_EMAIL_DOMAIN=conduktor.io
ATLAS_ADMINS=sderosiaux
ATLAS_WORKERS=8
# Per Go process soft budget; the web process and worker can both be resident.
ATLAS_MEMORY_BUDGET=4GiB

# On first startup, open the private setup URL from the container logs.
# The GitHub App wizard saves its credentials directly in the private data volume.
